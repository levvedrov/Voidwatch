# Voidwatch Backend Configuration
# Copy this file to .env and fill in your values

# Database — SQLite (default, no setup needed) or PostgreSQL
DATABASE_URL=sqlite:///./voidwatch.db
# DATABASE_URL=postgresql://user:password@localhost:5432/voidwatch

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# API key — leave empty to disable auth, set to a strong random string to enable
VOIDWATCH_API_KEY=

# CORS — comma-separated list of allowed origins, or * to allow all
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.100
